# Karmancos ID settings are server-only. Never prefix these with VITE_.
# Karmancos ID issuer verified against its OIDC Discovery document.
KARMANCOSID_ISSUER=https://karmancosid.vercel.app
KARMANCOSID_CLIENT_ID=kmc_6wl2RQk8abb0ZDssUWOg6WMQ
KARMANCOSID_CLIENT_SECRET=
# Production: https://knote.karmancos.space/auth/callback
# Local development: register http://localhost:5173/auth/callback and http://localhost:5173 as the web origin.
KARMANCOSID_REDIRECT_URI=
# Generate a separate random key of at least 32 characters for encrypted KNote session cookies.
KNOTE_SESSION_SECRET=
# MongoDB Atlas connection string and database name. Keep server-only; never use a VITE_ prefix.
KNOTE_MONGODB_URI=
KNOTE_MONGODB_DB=knote
# Token created when a private Vercel Blob store is connected to this project.
BLOB_READ_WRITE_TOKEN=
